createToggle(miscPage, "Sky Destroyer (Layered Clothing)", "Distort 3D WrapLayer geometry across sky & ground", function(state)
    SkyDestroyerActive = state
    local char = LocalPlayer.Character
    if not char then return end

    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("WrapLayer") then
            pcall(function()
                obj.Puffiness = SkyDestroyerActive and 9999 or 1
            end)
        end
    end
    Notify("Sky Destroyer", SkyDestroyerActive and "Cover Active!" or "Disabled", 2)
end)

createSectionTitle(miscPage, "Defense")

createToggle(miscPage, "Anti-Fling", "Disable character collision to prevent being flung", function(state)
    if state then
        RunService:BindToRenderStep("DeltaAntiFling", Enum.RenderPriority.Character.Value, function()
            local char = LocalPlayer.Character
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
        Notify("Anti-Fling", "Enabled (No-Collide active)", 2)
    else
        pcall(function()
            RunService:UnbindFromRenderStep("DeltaAntiFling")
        end)
        Notify("Anti-Fling", "Disabled", 2)
    end
end)

