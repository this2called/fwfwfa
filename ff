function createSubTabBar(parent, list)
    local subBar = Instance.new("ScrollingFrame")
    subBar.Name = "SubTabBar"
    subBar.Size = UDim2.new(1, 0, 0, 36)
    subBar.Position = UDim2.new(0, 0, 0, 0)
    subBar.BackgroundColor3 = tbl3.secondary
    subBar.BorderSizePixel = 0
    subBar.ScrollBarThickness = 0
    subBar.ScrollingDirection = Enum.ScrollingDirection.X
    subBar.AutomaticCanvasSize = Enum.AutomaticSize.X
    subBar.CanvasSize = UDim2.new(0, 0, 0, 0)
    subBar.Parent = parent
    corner(subBar, 8)
    padding(subBar, 3, 4, 3, 4)

    local barLayout = Instance.new("UIListLayout")
    barLayout.FillDirection = Enum.FillDirection.Horizontal
    barLayout.SortOrder = Enum.SortOrder.LayoutOrder
    barLayout.Padding = UDim.new(0, 6)
    barLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    barLayout.Parent = subBar

    local tabs = {}
    local tabButtons = {}

    for i, item in ipairs(list) do
        local page = Instance.new("ScrollingFrame")
        page.Name = item.id .. "_content"
        page.Size = UDim2.new(1, 0, 1, -42)
        page.Position = UDim2.new(0, 0, 0, 42)
        page.BackgroundTransparency = 1
        page.BorderSizePixel = 0
        page.ScrollBarThickness = 3
        page.ScrollBarImageColor3 = tbl3.accent
        page.AutomaticCanvasSize = Enum.AutomaticSize.Y
        page.CanvasSize = UDim2.new(0, 0, 0, 0)
        page.Visible = (i == 1)
        page.Parent = parent
        padding(page, 4, 4, 8, 4)

        local layout = Instance.new("UIListLayout")
        layout.FillDirection = Enum.FillDirection.Vertical
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.Padding = UDim.new(0, 6)
        layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
        layout.Parent = page

        tabs[item.id] = page

        local btn = Instance.new("TextButton")
        btn.Name = "Tab_" .. item.id
        btn.Size = UDim2.new(0, 105, 1, -2)
        btn.BackgroundColor3 = (i == 1) and tbl3.accent or tbl3.card
        btn.BorderSizePixel = 0
        btn.Text = item.name
        btn.TextColor3 = (i == 1) and Color3.fromRGB(255, 255, 255) or tbl3.textMuted
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 11
        btn.Parent = subBar
        corner(btn, 6)

        table.insert(tabButtons, { button = btn, id = item.id })

        btn.MouseButton1Click:Connect(function()
            for _, tPage in pairs(tabs) do
                tPage.Visible = false
            end
            page.Visible = true

            for _, tb in ipairs(tabButtons) do
                if tb.id == item.id then
                    tb.button.BackgroundColor3 = tbl3.accent
                    tb.button.TextColor3 = Color3.fromRGB(255, 255, 255)
                else
                    tb.button.BackgroundColor3 = tbl3.card
                    tb.button.TextColor3 = tbl3.textMuted
                end
            end
        end)
    end

    return tabs
end

