createActionButton(flingPage, "Target Fling", "Launch selected player into the stratosphere", function()
    if not (SelectedTarget and SelectedTarget.Character and SelectedTarget.Character:FindFirstChild("HumanoidRootPart")) then
        Notify("Error", "Select a valid target first!", 2)
        return
    end

    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local tRoot = SelectedTarget.Character.HumanoidRootPart

    if not (myRoot and tRoot) then return end

    Notify("Flinging Target", "Executing velocity desync fling...", 2)

    local prevCFrame = myRoot.CFrame
    local startT = tick()

    local bav = Instance.new("BodyAngularVelocity")
    bav.Name = "FlingTorque"
    bav.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    bav.AngularVelocity = Vector3.new(999999, 999999, 999999)
    bav.Parent = myRoot

    local conn
    conn = RunService.Heartbeat:Connect(function()
        if tick() - startT > 2.5 or not tRoot or not tRoot.Parent then
            conn:Disconnect()
            bav:Destroy()
            myRoot.Velocity = Vector3.new(0, 0, 0)
            myRoot.RotVelocity = Vector3.new(0, 0, 0)
            myRoot.CFrame = prevCFrame
            return
        end

        for _, part in ipairs(myChar:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end

        myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 0)
        myRoot.Velocity = Vector3.new(9999, 9999, 9999)
    end)
end)

